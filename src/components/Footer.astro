---
import { site, byType, hasPage, href, telHref, telClass, estimateHref, estimateLabel, estimateShort } from '../lib/site.js';
import Photo from './Photo.astro';
const services = byType('service');
const footerServices = [
  ['gutter-installation', 'Gutter Installation'],
  ['gutter-cleaning', 'Gutter Cleaning'],
  ['gutter-repair', 'Gutter Repairs'],
  ['gutter-guards', 'Gutter Guards'],
  ['commercial-gutters', 'Commercial Gutters'],
].map(([slug, name]) => ({ page: services.find((service) => service.slug === slug), name })).filter((item) => item.page);
const company = ['about','reviews','service-areas','faq','contact','careers','meet-the-team'].filter(hasPage);
const legal = byType('legal');
const terms = legal.find((page) => page.slug === 'terms-conditions');
const privacy = legal.find((page) => page.slug === 'privacy-policy');
const otherPolicies = legal.filter((page) => !['terms-conditions', 'privacy-policy'].includes(page.slug));
const label = (s) => s.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' ').replace('Faq','FAQ');
const ext = site.externalLinks || {};
const { hideEstimate = false } = Astro.props;
---
<footer id="footer"><div class="wrap">
  <div class="cols">
    <div><h4>About {site.businessName}</h4><p>{site.footerAbout}</p></div>
    {footerServices.length > 0 && <div><h4>Services</h4><ul>{footerServices.map(({ page, name }) => <li><a href={href(page.slug)}>{name}</a></li>)}</ul></div>}
    <div><h4>Company</h4><ul>
      {company.map((s) => <li><a href={href(s)}>{label(s)}</a></li>)}
      {hasPage('services') && <li><a href="/services/">Gutter Services</a></li>}
    </ul></div>
    <div class="footer-contact"><h4>Get in touch</h4>
      {site.logo && <a class="footer-logo" href="/" aria-label={`${site.businessName} home`}><Photo file={site.logo} alt="" widths={[360]} sizes="200px" /></a>}
      {site.address?.street && <address>
        <strong>{site.businessName}</strong>
        <span>{site.address.street}</span>
        <span>{site.address.city}, {site.address.state} {site.address.zip}</span>
      </address>}
      <ul>
      {site.phoneDisplay && <li><a class={telClass} href={telHref}>{site.phoneDisplay}</a></li>}
      {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
      {!hideEstimate && <li><a href={estimateHref}>{estimateLabel}</a></li>}
      {ext.mainSite?.url && ext.mainSite.placements?.includes('footer') && <li><a href={ext.mainSite.url}>{ext.mainSite.anchor}</a></li>}
      {ext.gbp?.url && ext.gbp.placements?.includes('footer') && <li><a href={ext.gbp.url} rel="noopener">{ext.gbp.anchor}</a></li>}
      </ul>
    </div>
  </div>
  <div class="bar">
    <div class="copyright">© {site.businessName}</div>
    {terms && <nav class="legal-nav" aria-label="Policies">
      <a class="legal-parent" href={href(terms.slug)}>{terms.breadcrumbLabel || terms.h1}</a>
      <ul>
        {privacy && <li><a href={href(privacy.slug)}>{privacy.breadcrumbLabel || privacy.h1}</a></li>}
        <li><a href={`${href(terms.slug)}#copyright`}>Copyright</a></li>
        {otherPolicies.map((page) => <li><a href={href(page.slug)}>{page.breadcrumbLabel || page.h1}</a></li>)}
      </ul>
    </nav>}
    <div>Site Built by BW</div>
  </div>
</div></footer>
<div class:list={['callbar', { single: hideEstimate }]}><a class={telClass} href={telHref}>Call now</a>{!hideEstimate && <a href={estimateHref}>{estimateShort}</a>}</div>
