---
// LOCKED: schema output. Built only from site.json and page frontmatter.
import { site, href, crumbsFor } from '../lib/site.js';
const { page } = Astro.props;
const base = site.siteUrl.replace(/\/$/, '');
const abs = (p) => base + p;
const bizId = `${base}/#business`;
const business = {
  '@type': site.schemaType, '@id': bizId, name: site.businessName, url: base + '/', telephone: site.phoneE164,
  ...(site.additionalType && { additionalType: site.additionalType }),
  ...(site.email && { email: site.email }),
  ...(site.address?.street && { address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.city, addressRegion: site.address.state, postalCode: site.address.zip, addressCountry: 'US' } }),
  ...(site.geo?.lat && { geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng } }),
  ...(site.hours?.length && { openingHoursSpecification: site.hours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes })) }),
  ...(site.areaServed?.length && { areaServed: site.areaServed.map((a) => ({ '@type': 'City', name: `${a.name}, ${a.state}`, ...(a.sameAs && { sameAs: a.sameAs }) })) }),
  ...(site.sameAs?.length && { sameAs: site.sameAs }),
  ...(site.owner?.name && { founder: { '@type': 'Person', name: site.owner.name, ...(site.owner.title && { jobTitle: site.owner.title }) } }),
};
const graph = [business];
const isHome = page.pageType === 'home';
if (!isHome) {
  const trail = crumbsFor(page);
  graph.push({ '@type': 'BreadcrumbList', itemListElement: trail.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, item: abs(t.to) })) });
}
if (page.pageType === 'service' || page.pageType === 'location') {
  graph.push({ '@type': 'Service', serviceType: page.serviceType || page.breadcrumbLabel || page.h1, provider: { '@id': bizId }, url: abs(href(page.slug)),
    areaServed: page.city ? { '@type': 'City', name: page.city + (page.state ? `, ${page.state}` : '') } : business.areaServed });
}
if (page.faqs?.length) graph.push({ '@type': 'FAQPage', mainEntity: page.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const homeBusinessJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': 'https://edenprairiegutterinstallers.com/#business',
  name: 'Eden Prairie Gutter Installers',
  url: 'https://edenprairiegutterinstallers.com/',
  telephone: '+17633173366',
  image: 'https://edenprairiegutterinstallers.com/logo.svg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '8929 Aztec Dr',
    addressLocality: 'Eden Prairie',
    addressRegion: 'MN',
    postalCode: '55347',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'City',
    name: 'Eden Prairie',
    containedInPlace: {
      '@type': 'State',
      name: 'Minnesota',
    },
  },
  additionalType: 'https://en.wikipedia.org/wiki/Rain_gutter',
  parentOrganization: {
    '@type': 'HomeAndConstructionBusiness',
    name: 'Big Mikes Gutters',
    url: 'https://bigmikesgutters.net/',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '07:00',
      closes: '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Sunday',
      opens: '09:00',
      closes: '13:00',
    },
  ],
});
const homeFaqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: (page.faqs || []).map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---
{isHome ? (
  <>
    <script type="application/ld+json" set:html={homeBusinessJson} />
    <script type="application/ld+json" set:html={homeFaqJson} />
  </>
) : (
  <script type="application/ld+json" set:html={json} />
)}
