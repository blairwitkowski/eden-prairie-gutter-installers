---
import { site, byType, hasPage, href, estimateHref } from '../lib/site.js';
import Photo from './Photo.astro';
const services = byType('service');
const serviceMenu = [
  ['gutter-installation', 'Gutter Installation'],
  ['gutter-cleaning', 'Gutter Cleaning'],
  ['gutter-repair', 'Gutter Repairs'],
  ['gutter-downspouts', 'Gutter Downspouts'],
  ['copper-gutters', 'Copper Gutters'],
  ['commercial-gutters', 'Commercial Gutters'],
].map(([slug, name]) => ({ page: services.find((service) => service.slug === slug), name })).filter((item) => item.page);
const nav = [
  hasPage('service-areas') && { name: 'Service Area', to: '/service-areas/' },
  hasPage('about') && { name: 'About', to: '/about/' },
  hasPage('reviews') && { name: 'Reviews', to: '/reviews/' },
  hasPage('faq') && { name: 'FAQ', to: '/faq/' },
  hasPage('contact') && { name: 'Contact', to: '/contact/' },
].filter(Boolean);
---
<header class="site"><div class="wrap">
  <a class="logo" href="/" aria-label={`${site.businessName} home`}>
    {site.logo ? <Photo file={site.logo} alt={site.businessName} eager widths={[320]} sizes="220px" /> : <>{site.businessName}{site.tagline && <span>{site.tagline}</span>}</>}
  </a>
  <nav class="main" aria-label="Main">
    {serviceMenu.length > 0 ? (
      <div class="has-sub">
        <a href={hasPage('services') ? '/services/' : href(serviceMenu[0].page.slug)}>Services</a>
        <div class="sub">
          {serviceMenu.map(({ page, name }) => <a href={href(page.slug)}>{name}</a>)}
          {hasPage('services') && <a href="/services/">All Services</a>}
        </div>
      </div>
    ) : hasPage('services') && <a href="/services/">Services</a>}
    {nav.map((n) => <a href={n.to}>{n.name}</a>)}
  </nav>
  <div class="head-cta">
    <a class="btn btn-line" href={site.bookingUrl || estimateHref}>{site.bookingUrl ? 'Book online' : 'Get A Free Estimate'}</a>
    <button class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>
</div>
<div class="mobile-nav" id="mobile-nav"><div class="wrap">
  {serviceMenu.length > 0 && <div class="group">Services</div>}
  {serviceMenu.map(({ page, name }) => <a href={href(page.slug)}>{name}</a>)}
  {serviceMenu.length > 0 && hasPage('services') && <a href="/services/">All Services</a>}
  {serviceMenu.length === 0 && hasPage('services') && <a href="/services/">Services</a>}
  <div class="group">Company</div>
  {nav.map((n) => <a href={n.to}>{n.name}</a>)}
</div></div>
</header>
<script>
  const b = document.querySelector('.menu-btn'), m = document.getElementById('mobile-nav');
  b?.addEventListener('click', () => { const o = m.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
</script>
