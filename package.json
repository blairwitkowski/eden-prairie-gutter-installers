{
  "name": "@workspace/eden-prairie-gutter-installers",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preset": "node scripts/apply-preset.mjs",
    "dev": "node scripts/apply-preset.mjs && (astro dev stop || true) && astro dev --host 0.0.0.0 --port ${PORT:-4321} --allowed-hosts --background && astro dev logs --follow",
    "build": "node scripts/apply-preset.mjs && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "node scripts/apply-preset.mjs && astro build && node scripts/check.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
